// Cloudflare Workers static assets: serves the Next.js static export in ./out.
// Deployed by GitHub Actions (.github/workflows/ci.yml, job "deploy") on pushes to main only;
// Cloudflare itself is not connected to GitHub and never builds anything.
{
  "name": "mastermind",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./out",
    "not_found_handling": "404-page"
  }
}
